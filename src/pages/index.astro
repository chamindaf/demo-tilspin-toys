---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section aria-labelledby="catalog-filters-heading" class="mb-8">
      <h2 id="catalog-filters-heading" class="sr-only">Filter games</h2>
      <form id="catalog-filters" class="bg-slate-900/60 border border-slate-700 rounded-xl p-5" data-testid="catalog-filters">
        <div class="grid gap-6 md:grid-cols-[1fr_260px]">
          <fieldset>
            <legend class="mb-3 text-sm font-semibold text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label class="inline-flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-slate-200 cursor-pointer hover:border-blue-500 transition-colors">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    class="size-4 accent-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid={`category-filter-${category.id}`}
                  />
                  {category.name}
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">Publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="mt-5 flex items-center justify-between gap-4">
          <p id="catalog-filter-status" role="status" aria-live="polite" class="text-sm text-slate-300" data-testid="catalog-filter-status">
            Showing all {games.length} games
          </p>
          <button
            type="reset"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-100 hover:bg-slate-700 transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="reset-filters"
          >
            Reset filters
          </button>
        </div>
      </form>
    </section>

    <div id="catalog-results">
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 && (
        <EmptyState text="No games available at the moment." />
      )}
      <div
        id="games-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        data-testid="games-grid"
      >
        {games.map((game) => <GameCard game={game} />)}
      </div>
      <div id="no-filter-results" class="hidden" data-testid="no-filter-results">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('#catalog-filters');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const gamesGrid = document.querySelector<HTMLElement>('#games-grid');
  const noResults = document.querySelector<HTMLElement>('#no-filter-results');
  const status = document.querySelector<HTMLElement>('#catalog-filter-status');

  function applyFilters(): void {
    if (!filterForm) return;

    const formData = new FormData(filterForm);
    const categoryIds = (formData.getAll('category') as string[]);
    const publisherId = formData.get('publisher')?.toString() ?? '';
    let visibleCount = 0;

    for (const card of gameCards) {
      const categoryMatches = categoryIds.length === 0 ||
        categoryIds.includes(card.dataset.categoryId ?? '');
      const publisherMatches = publisherId === '' ||
        card.dataset.publisherId === publisherId;
      const visible = categoryMatches && publisherMatches;

      card.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    }

    if (gamesGrid) {
      gamesGrid.classList.toggle('hidden', visibleCount === 0);
    }
    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount !== 0);
    }
    if (status) {
      status.textContent = `Showing ${visibleCount} of ${gameCards.length} games`;
    }
  }

  filterForm?.addEventListener('change', applyFilters);
  filterForm?.addEventListener('reset', () => {
    requestAnimationFrame(applyFilters);
  });
</script>
